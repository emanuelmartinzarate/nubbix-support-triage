# Proveedor por defecto: anthropic | gemini
LLM_PROVIDER=anthropic

# Credenciales (nunca commitear valores reales)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modelos por proveedor (ver src/triage/pricing.yaml para precios)
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.8-flash

# Versión de prompt activa (prompts/*.yaml, campo "version")
PROMPT_VERSION=v1

# Parámetros de la llamada: temperatura baja para clasificación estable
TEMPERATURE=0.0
# Tope de tokens de salida: el contrato JSON ocupa ~150-300 tokens
MAX_TOKENS=600

# Reintentos ante JSON inválido (re-pregunta con el error de validación)
PARSE_MAX_RETRIES=2
# Reintentos con backoff ante errores transitorios del proveedor (429/5xx/timeout)
API_MAX_RETRIES=3
# Timeout por request al proveedor, en segundos
REQUEST_TIMEOUT_S=30

# Log append-only de métricas por request
METRICS_PATH=data/metrics.jsonl
# Caché MD5 de respuestas
CACHE_DIR=data/cache
CACHE_ENABLED=true

# Guardrails de entrada/salida y moderación LLM (capa opcional, cuesta una llamada extra)
GUARDRAILS_ENABLED=true
MODERATION_ENABLED=false
# Longitud máxima de la consulta en caracteres
MAX_QUERY_CHARS=4000

# Tope de costo por invocación del runner de evals (USD)
EVAL_MAX_COST_USD=2.0
# Requests en paralelo durante evals (1 = secuencial)
EVAL_CONCURRENCY=1
